{
  "name": "@ssyazilim/ss-shopping-ui",
  "version": "0.0.1",
  "description": "Shared Nuxt layer with content blocks and UI components for SS Software projects",
  "author": "BARIS GUR",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "config",
    "public",
    "nuxt.config.ts"
  ],
  "scripts": {
    "dev:prepare": "nuxi prepare --envName typegen",
    "format": "prettier -uw --cache .",
    "lint": "pnpm lint:eslint && pnpm run:stylelint",
    "lint:eslint": "eslint . --cache --cache-location ./node_modules/.cache/eslint/",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "prepare": "is-ci || husky",
    "run:stylelint": "stylelint --fix --cache --cache-location ./node_modules/.cache/stylelint/ '**/*.{css,scss,vue}'",
    "typecheck": "pnpm dev:prepare && vue-tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,vue,json,yaml,yml}": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint/",
    "*.{css,scss,vue}": "stylelint --fix --cache --cache-location ./node_modules/.cache/stylelint/",
    "*": "prettier -wu --cache"
  },
  "peerDependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@nuxt/icon": "^2.5.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@ssyazilim/ss-shopping-schemas": "^0.1.82",
    "@vite-pwa/nuxt": "^1.1.0",
    "nuxt": "^4.5.2",
    "swiper": "^12.1.0",
    "vue": "^3.5.0",
    "vue-star-rating": "=2.1.0",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@formkit/auto-animate": "^0.10.0",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/icon": "^2.5.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@ssyazilim/ss-shopping-schemas": "^0.1.82",
    "@vite-pwa/nuxt": "^1.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwindcss": "3.18.2",
    "eslint-plugin-yml": "^3.8.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.3.0",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.5.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "swiper": "^12.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vue-star-rating": "=2.1.0",
    "vue-tsc": "^3.1.0",
    "vue3-toastify": "^0.2.8",
    "zod": "4.4.3"
  }
}
